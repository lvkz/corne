#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        panesplit_v: split_vertically {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LS(BSLH)>;
            label = "SPLIT_VERTICALLY";
        };

        panesplit_h: split_horizontally {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp MINUS>;
            label = "SPLIT_HORIZONTALLY";
        };

        pane_close: close_pane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp X>;
            label = "CLOSE_PANE";
        };

        tmux: goto_pane_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "GOTO_PANE_1";
        };

        clipboard: clipboard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp ESC>,
                <&macro_wait_time 100>,
                <&kp LG(SPACE)>,
                <&macro_wait_time 450>,
                <&kp LG(NUMBER_4)>,
                <&macro_press>;

            label = "CLIPBOARD";
        };

        resize_left: resize_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp H>;
            label = "RESIZE_LEFT";
        };

        resize_down: resize_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp J>;
            label = "RESIZE_DOWN";
        };

        resize_up: resize_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp K>;
            label = "RESIZE_UP";
        };

        resize_right: resize_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp L>;
            label = "RESIZE_RIGHT";
        };

        max_pane: max_pane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp M>;
            label = "MAX_PANE";
        };

        force_quit: force_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LA(ESCAPE))>;
            label = "FORCE_QUIT";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CLCK &kp TILDE>;
            label = "TILDE";
        };

        acute: acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CLCK &kp SQT>;
            label = "ACUTE";
        };

        Super_Ctrl_Alt: Super_Ctrl_Alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LCTRL &kp LEFT_ALT>;
            label = "SUPER_CTRL_ALT";
        };
    };

    behaviors {
        hyper_space: hyper_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        move_to_workspace: move_to_workspace {
            compatible = "zmk,behavior-hold-tap";
            label = "MOVE_TO_WORKSPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <11 13 16 15 14 26 27 28 29 17 25 24 1 2 3 4 5 12 0 39 38 30 18 20 21 19 9 8 7 6>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&mo 4>;
            key-positions = <41 40>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <5 4>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        left_bracket1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        right_bracket1 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <29 28>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y                                &kp U  &kp I          &kp O    &kp P     &move_to_workspace 5 ESC
&kp LCTRL       &kp A  &kp S  &kp D     &kp F  &kp G        &kp H                                &kp J  &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N                                &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                              &kp LGUI  &mo 1  &kp ENTER    &hyper_space LS(LC(LA(LGUI))) SPACE  &mo 2  &kp BACKSPACE
            >;
        };

        lower {
            bindings = <
&kp LC(LG(Q))         &kp F1             &kp F2  &kp F3     &kp F4     &kp F5        &kp F6    &kp F7      &kp F8             &kp F9         &kp F10     &force_quit
&kp LG(LC(LEFT_ALT))  &kp F18            &none   &kp LA(E)  &kp LA(N)  &kp N0        &kp LEFT  &kp DOWN    &kp UP_ARROW       &kp RIGHT      &kp F11     &kp F12
&kp LEFT_SHIFT        &kp LG(LC(SPACE))  &tilde  &acute     &tmux      &kp DOLLAR    &kp F16   &clipboard  &kp LG(MINUS)      &kp LG(EQUAL)  &kp LG(N0)  &kp LG(LS(NUMBER_4))
                                                 &none      &trans     &none         &none     &mo 3       &kp LA(BACKSPACE)
            >;

            label = "Nav";
        };

        raise {
            display-name = "# and $";
            bindings = <
&trans          &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET       &kp AMPERSAND  &kp ASTRK   &kp LPAR  &kp RPAR  &kp BACKSLASH
&trans          &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp MINUS       &kp EQUAL      &kp GRAVE   &kp LBKT  &kp RBKT  &kp PIPE
&kp LEFT_SHIFT  &kp NUMBER_6     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &kp UNDERSCORE  &kp PLUS       &kp TILDE   &kp LBRC  &kp RBRC  &kp ASTERISK
                                               &kp LGUI      &mo 3         &trans          &trans          &trans         &kp DELETE
            >;
        };

        extra_layer {
            bindings = <
&bootloader  &none         &none         &none         &none         &none           &kp LA(LC(P))           &kp LC(LA(C))            &kp LA(LC(ENTER))  &none       &none              &bootloader
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LC(LA(LEFT_ARROW))  &kp LA(LC(LS(LG(F14))))  &kp LA(LC(RIGHT))  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&none        &none         &none         &none         &none         &none           &kp LA(LC(F13))         &kp LS(LC(LEFT))         &none              &kp C_PREV  &kp C_PLAY_PAUSE   &kp C_NEXT
                                         &none         &none         &none           &none                   &none                    &none
            >;

            label = "Extra";
        };

        letter_caps {
            bindings = <
&trans  &kp LS(Q)  &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)    &kp LS(Y)  &kp LS(U)  &kp LS(I)  &kp LS(O)  &kp LS(P)  &trans
&trans  &kp LS(A)  &kp LS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)    &kp LS(H)  &kp LS(J)  &kp LS(K)  &kp LS(L)  &kp SEMI   &kp APOS
&trans  &kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)    &kp LS(N)  &kp LS(M)  &kp COMMA  &kp DOT    &trans     &trans
                              &trans     &trans     &trans       &trans     &trans     &trans
            >;

            label = "All Caps";
        };

        Workspaces {
            bindings = <
&kp LG(LS(LEFT))   &kp LG(LC(LEFT_ARROW))  &kp LG(LA(N1))  &kp LG(LA(N2))  &kp LG(LA(N3))  &kp LG(LC(RIGHT))    &kp LA(LEFT)       &kp LA(DOWN)      &kp LA(UP)      &kp LA(RIGHT)      &trans  &trans
&kp LG(LS(RIGHT))  &kp LG(N1)              &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)           &kp LC(LA(LEFT))   &kp LC(LA(DOWN))  &kp LC(LA(UP))  &kp LC(LA(RIGHT))  &trans  &trans
&trans             &kp LG(N6)              &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(N0)           &kp LG(LA(COMMA))  &trans            &trans          &trans             &trans  &trans
                                                           &trans          &trans          &kp LG(SPACE)        &kp LG(LA(SPACE))  &trans            &trans
            >;
        };
    };
};
